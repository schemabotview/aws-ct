{
  "family": "order-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {"cpuArchitecture": "ARM64",
                      "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::111122223333:role/OrderApiExecution",
  "taskRoleArn": "arn:aws:iam::111122223333:role/OrderApi",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "111122223333.dkr.ecr.eu-west-2.amazonaws.com/order-api:1.4.2",
      "portMappings": [{"containerPort": 8080}],
      "stopTimeout": 30,
      "logConfiguration": {"logDriver": "awslogs", "options": {
        "awslogs-group": "/shop/order-api", "awslogs-region": "eu-west-2",
        "awslogs-stream-prefix": "app"}}
    }
  ]
}
